# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Server
SERVER_PORT=3001
NODE_ENV=development

# CORS - 允许的前端源
CORS_ORIGIN=http://localhost:5173

# Database (必需 - 后端 Drizzle 直连 Postgres, 用 Supabase Session Pooler)
# 密码含特殊字符需 URL 编码, 例: YourPass@123 -> YourPass%40123
# DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
