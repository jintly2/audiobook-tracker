# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Server
SERVER_PORT=3001
NODE_ENV=development

# Database (必需 - 后端 Drizzle 直连 Postgres)
# Supabase Session Pooler 格式（密码含特殊字符需 URL 编码）:
# postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# 例: postgresql://postgres.yourproject:password%40encoded@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://...
